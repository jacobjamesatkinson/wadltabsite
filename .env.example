# Database
# Local without Docker: use embedded PGlite (default)
DATABASE_URL=pglite
# Docker / self-hosted Postgres:
# DATABASE_URL=postgresql://wadl:wadl@localhost:5432/wadl_tab
# Vercel + Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/wadl_tab?sslmode=require

# Optional PGlite data directory (default: ./data/pglite)
# PGLITE_DATA_DIR=./data/pglite

# Better Auth (must be absolute URLs including https:// in production)
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel example:
# BETTER_AUTH_URL=https://wadltabsite-olive.vercel.app
# NEXT_PUBLIC_APP_URL=https://wadltabsite-olive.vercel.app

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed
SEED_ADMIN_EMAIL=admin@wadl.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_COORDINATOR_EMAIL=coordinator@wadl.local
SEED_COORDINATOR_PASSWORD=Coord123!
SEED_ADJUDICATOR_EMAIL=adjudicator@wadl.local
SEED_ADJUDICATOR_PASSWORD=Adj123!
